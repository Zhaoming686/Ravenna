{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build with cmake",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "${input:buildPreset}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "run SubgraphMatching",
      "type": "process",
      "command": "${workspaceFolder}/build-${input:buildPreset}/matching/SubgraphMatching.out",
      "args": [
        "-d",
        "${workspaceFolder}/case_study/data_graph/expanded_100k.graph",
        "-q",
        "${workspaceFolder}/case_study/query_graph/query_G_24_1.graph",
        "-filter",
        "VEQ",
        "-order",
        "CFL",
        "-engine",
        "Ravenna",
        "-time",
        "1",
        "-tau",
        "0.3"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "LD_LIBRARY_PATH": "/opt/software/gcc/13.2.0/lib64:${env:LD_LIBRARY_PATH}"
        }
      },
      "dependsOn": "build with cmake",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "buildPreset",
      "type": "pickString",
      "description": "Choose build preset",
      "options": [
        "local-test",
        "sbatch-release"
      ],
      "default": "local-test"
    }
  ]
}